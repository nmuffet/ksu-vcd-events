{
  "entities": {
    "Event": {
      "title": "Community Event",
      "description": "A community calendar event submission",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event identifier",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "description": "Event headline title",
          "maxLength": 140
        },
        "date": {
          "type": "string",
          "description": "Date of event in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "description": "Time of event",
          "maxLength": 80
        },
        "startTime": {
          "type": "string",
          "description": "Structured 24-hour start time (HH:mm)",
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "description": "Structured 24-hour end time (HH:mm)",
          "maxLength": 20
        },
        "isAllDay": {
          "type": "boolean",
          "description": "Whether the event runs all day"
        },
        "location": {
          "type": "string",
          "description": "Physical venue or meeting location",
          "maxLength": 250
        },
        "description": {
          "type": "string",
          "description": "Full event description",
          "maxLength": 3000
        },
        "contactEmail": {
          "type": "string",
          "description": "Organizer contact email address",
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "description": "Optional event webpage or registration URL",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "archived"],
          "description": "Moderation status"
        },
        "createdAt": {
          "type": "string",
          "description": "Submission ISO timestamp"
        },
        "reviewedAt": {
          "type": "string",
          "description": "Moderator review ISO timestamp"
        },
        "reviewedBy": {
          "type": "string",
          "description": "Moderator name or username",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Internal moderation notes",
          "maxLength": 1000
        },
        "suggestedEditForId": {
          "type": "string",
          "description": "Original event ID if this is an edit suggestion",
          "maxLength": 100
        },
        "suggestedEditTitle": {
          "type": "string",
          "description": "Original event title if this is an edit suggestion",
          "maxLength": 140
        }
      },
      "required": ["id", "title", "date", "time", "location", "description", "status", "createdAt"]
    },
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "A subscribed email address for weekly event digests",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Subscriber document ID"
        },
        "email": {
          "type": "string",
          "description": "Subscriber email address",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "enum": ["active", "unsubscribed"],
          "description": "Subscription status"
        },
        "createdAt": {
          "type": "string",
          "description": "Subscription timestamp"
        }
      },
      "required": ["id", "email", "status", "createdAt"]
    },
    "NewsletterRun": {
      "title": "Weekly Newsletter Run",
      "description": "Atomic weekly dispatch lock and delivery record keyed by Eastern week YYYY-MM-DD",
      "type": "object",
      "properties": {
        "weekKey": {
          "type": "string",
          "description": "Monday week identifier in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["sending", "sent", "failed"],
          "description": "Weekly dispatch execution state"
        },
        "lockedAt": {
          "type": "string",
          "description": "ISO timestamp when dispatch lock was acquired"
        },
        "lockedBy": {
          "type": "string",
          "description": "Instance identifier holding the dispatch lock",
          "maxLength": 100
        },
        "sentAt": {
          "type": "string",
          "description": "ISO timestamp when dispatch completed"
        },
        "campaignId": {
          "type": "number",
          "description": "Brevo campaign ID"
        },
        "eventsCount": {
          "type": "number",
          "description": "Number of events included in digest"
        },
        "deliveryMethod": {
          "type": "string",
          "description": "Delivery channel used (brevo_campaign or brevo_transactional_relay)",
          "maxLength": 60
        },
        "error": {
          "type": "string",
          "description": "Error message if failed",
          "maxLength": 500
        }
      },
      "required": ["weekKey", "status", "lockedAt"]
    },
    "NewsletterSettings": {
      "title": "Newsletter Auto-Pilot Settings",
      "description": "Persistent Auto-Pilot schedule preferences and latest run status",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID",
          "maxLength": 50
        },
        "autoSendEnabled": {
          "type": "boolean",
          "description": "Whether automated weekly sends are enabled"
        },
        "autoSendDayOfWeek": {
          "type": "number",
          "description": "Day of week (0=Sun, 1=Mon, ..., 6=Sat)"
        },
        "autoSendHour": {
          "type": "number",
          "description": "Hour of day in America/New_York (0-23)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "lastAutoSend": {
          "type": "object",
          "description": "Summary of the most recent automated send"
        }
      },
      "required": ["id", "updatedAt"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of community events"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Collection of newsletter subscribers"
    },
    "/newsletter_runs/{weekKey}": {
      "schema": "NewsletterRun",
      "description": "Atomic per-week newsletter send locks and history"
    },
    "/newsletter_settings/{settingId}": {
      "schema": "NewsletterSettings",
      "description": "Persistent Auto-Pilot configuration and lastAutoSend summary"
    }
  }
}
