rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEventCreate(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'location', 'description', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 100 && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 80
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 250
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.status in ['pending', 'approved', 'rejected', 'archived']
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20))
        && (!('isAllDay' in data) || data.isAllDay is bool)
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 120))
        && (!('url' in data) || (data.url is string && data.url.size() <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
        && (!('suggestedEditForId' in data) || (data.suggestedEditForId is string && data.suggestedEditForId.size() <= 100))
        && (!('suggestedEditTitle' in data) || (data.suggestedEditTitle is string && data.suggestedEditTitle.size() <= 140));
    }

    function isValidEventUpdate(data) {
      return (!('status' in data) || (data.status is string && data.status in ['pending', 'approved', 'rejected', 'archived']))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 140))
        && (!('date' in data) || (data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('time' in data) || (data.time is string && data.time.size() >= 1 && data.time.size() <= 80))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20))
        && (!('isAllDay' in data) || data.isAllDay is bool)
        && (!('location' in data) || (data.location is string && data.location.size() >= 1 && data.location.size() <= 250))
        && (!('description' in data) || (data.description is string && data.description.size() >= 1 && data.description.size() <= 3000))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 120))
        && (!('url' in data) || (data.url is string && data.url.size() <= 500))
        && (!('suggestedEditForId' in data) || (data.suggestedEditForId is string && data.suggestedEditForId.size() <= 100))
        && (!('suggestedEditTitle' in data) || (data.suggestedEditTitle is string && data.suggestedEditTitle.size() <= 140));
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.status in ['active', 'unsubscribed']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidNewsletterRun(data) {
      return data.keys().hasAll(['weekKey', 'status', 'lockedAt'])
        && data.weekKey is string && data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in ['sending', 'sent', 'failed']
        && data.lockedAt is string && data.lockedAt.size() <= 50
        && (!('lockedBy' in data) || (data.lockedBy is string && data.lockedBy.size() <= 100))
        && (!('sentAt' in data) || (data.sentAt is string && data.sentAt.size() <= 50))
        && (!('campaignId' in data) || data.campaignId is number)
        && (!('eventsCount' in data) || data.eventsCount is number)
        && (!('deliveryMethod' in data) || (data.deliveryMethod is string && data.deliveryMethod.size() <= 60))
        && (!('error' in data) || (data.error is string && data.error.size() <= 500));
    }

    function isValidNewsletterSettings(data) {
      return data.keys().hasAll(['id', 'updatedAt'])
        && data.id is string && data.id.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('autoSendEnabled' in data) || data.autoSendEnabled is bool)
        && (!('autoSendDayOfWeek' in data) || data.autoSendDayOfWeek is number)
        && (!('autoSendHour' in data) || data.autoSendHour is number);
    }

    match /events/{eventId} {
      // 1. Reading: Public can query approved events; moderators can view all events
      allow list: if true;
      allow get: if isValidId(eventId);

      // 2. Creating: Community submissions can create pending events; or any event adhering to the schema
      allow create: if isValidId(eventId) && isValidEventCreate(incoming());

      // 3. Updating: Allow updating events with valid schema attributes (e.g. approve, reject, edit)
      allow update: if isValidId(eventId) && isValidEventUpdate(incoming());

      // 4. Deleting: Allow deleting events
      allow delete: if isValidId(eventId);
    }

    match /subscribers/{subscriberId} {
      allow list, get: if true;
      allow create, update: if isValidSubscriber(incoming());
      allow delete: if true;
    }

    match /newsletter_runs/{weekKey} {
      allow list: if true;
      allow get: if isValidId(weekKey);
      allow create, update: if isValidId(weekKey) && isValidNewsletterRun(incoming());
      allow delete: if isValidId(weekKey);
    }

    match /newsletter_settings/{settingId} {
      allow list: if true;
      allow get: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isValidNewsletterSettings(incoming());
      allow delete: if isValidId(settingId);
    }
  }
}
