rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['nmuffet@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'location', 'description', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 100 && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 80
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 250
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
        && (!('suggestedEditForId' in data) || (data.suggestedEditForId is string && data.suggestedEditForId.size() <= 100))
        && (!('suggestedEditTitle' in data) || (data.suggestedEditTitle is string && data.suggestedEditTitle.size() <= 140));
    }

    match /events/{eventId} {
      // 1. Reading: Public can query approved events; anyone with the specific event ID can check status; Admin can read all
      allow list: if resource.data.status == 'approved' || isAdmin();
      allow get: if isValidId(eventId) || resource.data.status == 'approved' || isAdmin();

      // 2. Creating: Anonymous community submissions can create pending events; Admin can create any event
      allow create: if isValidId(eventId)
        && (
          (incoming().status == 'pending' && isValidEvent(incoming()))
          || isAdmin()
        );

      // 3. Updating: Only Admin can update events (approve, reject, edit)
      allow update: if isValidId(eventId)
        && isAdmin()
        && isValidEvent(incoming());

      // 4. Deleting: Only Admin can delete events
      allow delete: if isValidId(eventId) && isAdmin();
    }
  }
}
