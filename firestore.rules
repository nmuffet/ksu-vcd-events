rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEventCreate(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'location', 'description', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 100 && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 80
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 250
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20))
        && (!('isAllDay' in data) || data.isAllDay is bool)
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
        && (!('suggestedEditForId' in data) || (data.suggestedEditForId is string && data.suggestedEditForId.size() <= 100))
        && (!('suggestedEditTitle' in data) || (data.suggestedEditTitle is string && data.suggestedEditTitle.size() <= 140));
    }

    function isValidEventUpdate(data) {
      return (!('status' in data) || (data.status is string && data.status in ['pending', 'approved', 'rejected']))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 140))
        && (!('date' in data) || (data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('time' in data) || (data.time is string && data.time.size() >= 1 && data.time.size() <= 80))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20))
        && (!('isAllDay' in data) || data.isAllDay is bool)
        && (!('location' in data) || (data.location is string && data.location.size() >= 1 && data.location.size() <= 250))
        && (!('description' in data) || (data.description is string && data.description.size() >= 1 && data.description.size() <= 3000))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 120))
        && (!('suggestedEditForId' in data) || (data.suggestedEditForId is string && data.suggestedEditForId.size() <= 100))
        && (!('suggestedEditTitle' in data) || (data.suggestedEditTitle is string && data.suggestedEditTitle.size() <= 140));
    }

    match /events/{eventId} {
      // 1. Reading: Public can query approved events; moderators can view all events
      allow list: if true;
      allow get: if isValidId(eventId);

      // 2. Creating: Community submissions can create pending events; or any event adhering to the schema
      allow create: if isValidId(eventId) && isValidEventCreate(incoming());

      // 3. Updating: Allow updating events with valid schema attributes (e.g. approve, reject, edit)
      allow update: if isValidId(eventId) && isValidEventUpdate(incoming());

      // 4. Deleting: Allow deleting events
      allow delete: if isValidId(eventId);
    }
  }
}
